<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_item_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/widget_item_bg"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingLeft="8dp"
    android:paddingTop="5dp"
    android:paddingRight="8dp"
    android:paddingBottom="5dp">

    <TextView
        android:id="@+id/widget_item_period"
        android:layout_width="22dp"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:maxLines="1"
        android:text="1."
        android:textColor="#B5BDCE"
        android:textSize="12sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_item_time"
        android:layout_width="76dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="6dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="8:00 - 8:45"
        android:textColor="#7D8699"
        android:textSize="11sp" />

    <FrameLayout
        android:id="@+id/widget_item_bar"
        android:layout_width="3dp"
        android:layout_height="26dp"
        android:layout_marginLeft="6dp"
        android:layout_marginRight="8dp"
        android:background="#2E3546" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_item_subject"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Matematika"
            android:textColor="#F0F4FC"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_item_meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="U12 · Novák"
            android:textColor="#8C95A8"
            android:textSize="11sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_item_badge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="6dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="#7AB0FF"
        android:textSize="11sp"
        android:textStyle="bold"
        android:visibility="gone" />
</LinearLayout>
