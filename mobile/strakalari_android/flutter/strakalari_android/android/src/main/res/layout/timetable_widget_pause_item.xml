<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_pause_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingLeft="8dp"
    android:paddingTop="3dp"
    android:paddingRight="8dp"
    android:paddingBottom="3dp">

    <TextView
        android:id="@+id/widget_item_period"
        android:layout_width="22dp"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:maxLines="1"
        android:text="3."
        android:textColor="#6E768A"
        android:textSize="12sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_item_time"
        android:layout_width="76dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="6dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="10:00 - 10:45"
        android:textColor="#6E768A"
        android:textSize="11sp" />

    <FrameLayout
        android:id="@+id/widget_pause_box"
        android:layout_width="0dp"
        android:layout_height="24dp"
        android:layout_marginLeft="6dp"
        android:layout_weight="1"
        android:background="@drawable/widget_pause_slot_bg" />
</LinearLayout>
