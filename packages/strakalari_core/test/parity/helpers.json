      "fn": "parseDate",
      "args": [
        "15.09.2026"
      ],
      "expected": {
        "__datetime__": "2026-09-15T00:00:00"
      }
    },
    {
      "fn": "parseDate",
      "args": [
        "1. 9. 2026"
      ],
      "expected": {
        "__datetime__": "2026-09-01T00:00:00"
      }
    },
    {
      "fn": "parseDate",
      "args": [
        "3.9.2026 (čtvrtek)"
