{
  "module": "helpers",
  "cases": [
    {
      "fn": "parseDate",
      "args": [
        "15.09.2026"
      ],
      "expected": {
        "__datetime__": "2026-09-15T00:00:00"
      }
    },
    {
      "fn": "parseDate",
      "args": [
        "1. 9. 2026"
      ],
      "expected": {
        "__datetime__": "2026-09-01T00:00:00"
      }
    },
    {
      "fn": "parseDate",
      "args": [
        "3.9.2026 (čtvrtek)"
      ],
      "expected": {
        "__datetime__": "2026-09-03T00:00:00"
      }
    },
    {
      "fn": "parseDate",
      "args": [
        "Pondělí 1. 9. 2026"
      ],
      "expected": {
        "__datetime__": "2026-09-01T00:00:00"
      }
    },
    {
      "fn": "parseDate",
      "args": [
        "2026-11-25"
      ],
      "expected": {
        "__datetime__": "2026-11-25T00:00:00"
      }
    },
    {
      "fn": "parseDate",
      "args": [
        "25/11/2026"
      ],
      "expected": {
        "__datetime__": "2026-11-25T00:00:00"
      }
    },
    {
      "fn": "parseDate",
      "args": [
        "07.09.26"
      ],
      "expected": {
        "__datetime__": "2026-09-07T00:00:00"
      }
    },
    {
      "fn": "parseDate",
      "args": [
        "2026/09/07"
      ],
      "expected": {
        "__datetime__": "2026-09-07T00:00:00"
      }
    },
