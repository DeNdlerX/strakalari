    {
      "fn": "validatePreset",
      "args": [
        {
          "id": 1,
          "sem1_close": "bad",
          "lunch_cutoff_time": "99:99",
          "marks_percent_bands": [
            90,
            90,
            50
          ],
          "days": [
            [
              "bad",
              "label"
            ]
          ],
          "ranges": [
            "nope"
          ]
        }
      ],
      "expected": [
        "'title_cs' or 'title_en' is required",
        "'sem1_close' must be DD.MM.YYYY",
        "'lunch_cutoff_time' must be HH:MM",
        "'marks_percent_bands' must be four decreasing percentages within (0, 100] (the top of grades 2–5)",
        "bad 'days' entry ['bad', 'label'] (want [\"DD.MM.YYYY\", \"label\"])",
        "bad 'ranges' entry 'nope' (want [\"DD.MM.YYYY\", \"DD.MM.YYYY\", \"label\"])"
      ]
    },
