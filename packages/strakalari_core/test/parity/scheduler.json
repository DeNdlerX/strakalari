{
  "module": "scheduler",
  "cases": [
    {
      "fn": "nextDue",
      "args": [
        null,
        60,
        {
          "__datetime__": "2026-09-25T12:00:00"
        }
      ],
      "expected": {
        "__datetime__": "2026-09-25T12:00:00"
      }
    },
    {
      "fn": "nextDue",
      "args": [
        {
          "__datetime__": "2026-09-25T11:00:00"
        },
        30,
        {
          "__datetime__": "2026-09-25T12:00:00"
        }
      ],
      "expected": {
        "__datetime__": "2026-09-25T11:30:00"
      }
    },
    {
      "fn": "nextDue",
      "args": [
        {
          "__datetime__": "2026-09-25T11:00:00"
        },
        null,
        {
          "__datetime__": "2026-09-25T12:00:00"
        }
      ],
      "expected": {
        "__datetime__": "2026-09-25T12:00:00"
      }
    },
    {
      "fn": "nextDue",
      "args": [
        {
          "__datetime__": "2026-09-25T11:00:00"
        },
        0,
        {
          "__datetime__": "2026-09-25T12:00:00"
        }
      ],
      "expected": {
        "__datetime__": "2026-09-25T11:01:00"
      }
    }
  ]
}
