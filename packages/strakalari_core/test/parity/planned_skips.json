{
  "module": "planned_skips",
  "cases": [
    {
      "fn": "normalizePlannedEntry",
      "args": [
        {
          "date": "2026-10-05",
          "template": "dentist"
        }
      ],
      "expected": {
        "start_date": "2026-10-05",
        "end_date": "2026-10-05",
        "template": "dentist"
      }
    },
    {
      "fn": "normalizePlannedEntry",
      "args": [
        {
          "start_date": "2026-10-05",
          "end_date": "2026-10-07",
          "start_period": 2,
          "end_period": 4,
          "template": "trip",
          "cancel_lunch": false
        }
      ],
      "expected": {
        "start_date": "2026-10-05",
        "end_date": "2026-10-07",
        "template": "trip",
        "start_period": 2,
        "end_period": 4,
        "cancel_lunch": false
      }
    },
    {
      "fn": "normalizePlannedEntry",
      "args": [
        {
          "start_date": "2026-10-07",
          "end_date": "2026-10-05",
          "template": "swap"
        }
      ],
      "expected": {
        "start_date": "2026-10-05",
        "end_date": "2026-10-07",
        "template": "swap"
      }
    },
    {
      "fn": "normalizePlannedEntry",
      "args": [
        {
          "start_date": "nonsense",
          "template": "bad"
        }
      ],
      "expected": null
