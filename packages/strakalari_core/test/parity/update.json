{
  "module": "update",
  "cases": [
    {
      "fn": "normalizeChannel",
      "args": [
        "stable"
      ],
      "expected": "stable"
    },
    {
      "fn": "normalizeChannel",
      "args": [
        "BETA"
      ],
      "expected": "beta"
    },
    {
      "fn": "normalizeChannel",
      "args": [
        " beta "
      ],
      "expected": "beta"
    },
    {
      "fn": "normalizeChannel",
      "args": [
        "nightly"
      ],
      "expected": "stable"
    },
    {
      "fn": "normalizeChannel",
      "args": [
        ""
      ],
      "expected": "stable"
    },
    {
      "fn": "normalizeChannel",
      "args": [
        null
      ],
      "expected": "stable"
    },
    {
      "fn": "normalizeChannel",
      "args": [
        5
      ],
      "expected": "stable"
    },
    {
      "fn": "parseVersion",
      "args": [
        "v1.2.3"
      ],
      "expected": [
        1,
        2,
        3
      ]
    },
    {
      "fn": "parseVersion",
      "args": [
        "1.2"
      ],
      "expected": [
        1,
        2
      ]
    },
    {
      "fn": "parseVersion",
      "args": [
        "v0.1.0-beta.1"
      ],
      "expected": [
        0,
        1,
        0
      ]
    },
    {
      "fn": "parseVersion",
      "args": [
        "abc"
      ],
      "expected": [
        0
      ]
    },
    {
      "fn": "parseVersion",
      "args": [
        ""
      ],
      "expected": [
        0
      ]
    },
    {
      "fn": "parseVersion",
      "args": [
        "  v2.0.0-rc.1+build "
      ],
      "expected": [
        2,
        0,
        0
      ]
    },
    {
      "fn": "splitVersion",
      "args": [
        "v0.1.0-beta.1+abc"
      ],
      "expected": [
        [
          0,
          1,
          0
        ],
        "beta.1"
      ]
    },
    {
      "fn": "splitVersion",
      "args": [
        "1.2.3"
      ],
      "expected": [
        [
          1,
          2,
          3
        ],
        ""
      ]
    },
    {
      "fn": "splitVersion",
      "args": [
        "v1.0"
      ],
      "expected": [
        [
          1,
          0
        ],
        ""
      ]
    },
    {
      "fn": "isPrereleaseVersion",
      "args": [
        "1.2.3"
      ],
      "expected": false
    },
    {
      "fn": "isPrereleaseVersion",
      "args": [
        "1.2.3-beta.1"
      ],
      "expected": true
    },
    {
      "fn": "isPrereleaseVersion",
      "args": [
        "1.2.3-rc.1"
      ],
      "expected": true
    },
    {
      "fn": "versionKey",
      "args": [
        "0.1.0-beta.1"
      ],
      "expected": [
        [
          0,
          1
        ],
        0,
        [
          [
            1,
            0,
            "beta"
          ],
          [
            0,
            1,
            ""
          ]
        ]
      ]
    },
    {
      "fn": "versionKey",
      "args": [
        "0.1.0-beta.2"
      ],
      "expected": [
        [
          0,
          1
        ],
        0,
        [
          [
            1,
            0,
            "beta"
          ],
          [
            0,
            2,
            ""
          ]
        ]
      ]
    },
    {
      "fn": "versionKey",
      "args": [
        "0.1.0"
      ],
      "expected": [
        [
          0,
          1
        ],
        1,
        []
      ]
    },
    {
      "fn": "versionKey",
      "args": [
        "0.1.1"
      ],
      "expected": [
        [
          0,
          1,
          1
        ],
        1,
        []
      ]
    },
    {
      "fn": "versionKey",
      "args": [
        "1.2"
      ],
      "expected": [
        [
          1,
          2
        ],
        1,
        []
      ]
    },
    {
      "fn": "versionKey",
      "args": [
        "1.2.0"
      ],
      "expected": [
        [
          1,
          2
        ],
        1,
        []
      ]
    },
    {
      "fn": "isNewer",
      "args": [
        "1.3.0",
        "1.2.0"
      ],
      "expected": true
    },
    {
      "fn": "isNewer",
      "args": [
        "1.2.0",
        "1.2.0"
      ],
      "expected": false
    },
    {
      "fn": "isNewer",
      "args": [
        "1.2.0-beta.1",
        "1.2.0"
      ],
      "expected": false
    },
    {
      "fn": "isNewer",
      "args": [
        "1.2.0",
        "1.2.0-beta.1"
      ],
      "expected": true
    },
    {
      "fn": "isNewer",
      "args": [
        "0.9.9",
        "1.0.0"
      ],
      "expected": false
    },
    {
      "fn": "releaseInfo",
      "args": [
        {
          "tag_name": "v1.2.0",
          "html_url": "https://example.test/r/v1.2.0",
          "name": "Release 1.2.0",
          "published_at": "2026-09-01T10:00:00Z",
          "prerelease": false,
          "draft": false
        }
      ],
      "expected": {
        "version": "1.2.0",
        "tag": "v1.2.0",
        "url": "https://example.test/r/v1.2.0",
        "name": "Release 1.2.0",
        "published_at": "2026-09-01T10:00:00Z",
        "prerelease": false,
        "draft": false
      }
    },
    {
      "fn": "releaseInfo",
      "args": [
        {
          "tag_name": "v1.3.0-beta.1",
          "prerelease": true,
          "draft": false
        }
      ],
      "expected": {
        "version": "1.3.0-beta.1",
        "tag": "v1.3.0-beta.1",
        "url": "https://github.com/DeNdlerX/strakalari/releases",
        "name": "v1.3.0-beta.1",
        "published_at": "",
        "prerelease": true,
        "draft": false
      }
    },
    {
      "fn": "releaseInfo",
      "args": [
        {
          "tag_name": "v1.1.0",
          "draft": true
        }
      ],
      "expected": {
        "version": "1.1.0",
        "tag": "v1.1.0",
        "url": "https://github.com/DeNdlerX/strakalari/releases",
        "name": "v1.1.0",
        "published_at": "",
        "prerelease": false,
        "draft": true
      }
    },
    {
      "fn": "releaseInfo",
      "args": [
        {
          "no_tag": true
        }
      ],
      "expected": null
    },
    {
      "fn": "releaseInfo",
      "args": [
        {}
      ],
      "expected": null
    },
    {
      "fn": "pickRelease",
      "args": [
        [
          {
            "tag_name": "v1.2.0",
            "html_url": "https://example.test/r/v1.2.0",
            "name": "Release 1.2.0",
            "published_at": "2026-09-01T10:00:00Z",
            "prerelease": false,
            "draft": false
          },
          {
            "tag_name": "v1.3.0-beta.1",
            "prerelease": true,
            "draft": false
          },
          {
            "tag_name": "v1.1.0",
            "draft": true
          }
        ],
        "stable"
      ],
      "expected": {
        "version": "1.2.0",
        "tag": "v1.2.0",
        "url": "https://example.test/r/v1.2.0",
        "name": "Release 1.2.0",
        "published_at": "2026-09-01T10:00:00Z",
        "prerelease": false,
        "draft": false
      }
    },
    {
      "fn": "pickRelease",
      "args": [
        [
          {
            "tag_name": "v1.2.0",
            "html_url": "https://example.test/r/v1.2.0",
            "name": "Release 1.2.0",
            "published_at": "2026-09-01T10:00:00Z",
            "prerelease": false,
            "draft": false
          },
          {
            "tag_name": "v1.3.0-beta.1",
            "prerelease": true,
            "draft": false
          },
          {
            "tag_name": "v1.1.0",
            "draft": true
          }
        ],
        "beta"
      ],
      "expected": {
        "version": "1.3.0-beta.1",
        "tag": "v1.3.0-beta.1",
        "url": "https://github.com/DeNdlerX/strakalari/releases",
        "name": "v1.3.0-beta.1",
        "published_at": "",
        "prerelease": true,
        "draft": false
      }
    },
    {
      "fn": "pickRelease",
      "args": [
        [],
        "stable"
      ],
      "expected": null
    },
    {
      "fn": "shouldCheck",
      "args": [
        null,
        1780000000.0
      ],
      "expected": true
    },
    {
      "fn": "shouldCheck",
      "args": [
        {
          "checked_at": 1779996400.0
        },
        1780000000.0
      ],
      "expected": false
    },
    {
      "fn": "shouldCheck",
      "args": [
        {
          "checked_at": 1779910000.0
        },
        1780000000.0
      ],
      "expected": true
    },
    {
      "fn": "shouldCheck",
      "args": [
        {
          "checked_at": "garbage"
        },
        1780000000.0
      ],
      "expected": true
    },
    {
      "fn": "updateAvailable",
      "args": [
        {
          "version": "9.9.9",
          "tag": "v9.9.9"
        },
        "1.0.0"
      ],
      "expected": true
    },
    {
      "fn": "updateAvailable",
      "args": [
        {
          "version": "9.9.9",
          "tag": "v9.9.9"
        },
        "9.9.9"
      ],
      "expected": false
    },
    {
      "fn": "updateAvailable",
      "args": [
        null,
        "1.0.0"
      ],
      "expected": false
    }
  ]
}
